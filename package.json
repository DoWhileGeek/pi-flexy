{
  "name": "@dowhilegeek/pi-flexy",
  "version": "0.1.3",
  "description": "Session-scoped OpenAI Flex controls for Pi, with transport-level request audits.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai",
    "flex"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/flex.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check && npm run check:package"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^22.19.19",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "author": {
    "name": "DoWhileGeek",
    "url": "https://github.com/DoWhileGeek"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoWhileGeek/pi-flexy.git"
  },
  "homepage": "https://github.com/DoWhileGeek/pi-flexy#readme",
  "bugs": {
    "url": "https://github.com/DoWhileGeek/pi-flexy/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
